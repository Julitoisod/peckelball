#--------------------------------------------------------------------
# Bernie Pickleball — environment
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL is intentionally unset — Config\App auto-detects it so the
# same checkout runs under `php spark serve` and under XAMPP/Apache.
app.indexPage = ''
app.appTimezone = 'Asia/Manila'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = bernie_pickleball
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SECURITY (CSRF)
#--------------------------------------------------------------------

security.csrfProtection = 'session'
security.tokenRandomize = true
security.tokenName = 'csrf_bernie'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_bernie'
security.expires = 7200
# Per-session token, not per-request. Rotating on every successful POST kills
# every other form the person has open — second tab, back button, an admin
# screen left up — which is where the 403s came from. This is what Laravel,
# Django and Rails do; tokenRandomize still masks the value on every render.
security.regenerate = false
security.redirect = false

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'bernie_session'
session.expiration = 7200
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# COOKIE
#--------------------------------------------------------------------

cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4
